@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="bg-light rounded-3 p-5 border">
                <h1 class="fw-semibold mt-3 mb-2">Sistema de Alquiler</h1>
                <p class="text-muted mb-4">Gestión de propiedades residenciales.</p>
                <a asp-controller="Casas" asp-action="ConsultaCasas" class="btn btn-primary me-2">Ver propiedades</a>
                <a asp-controller="Casas" asp-action="AlquilerCasas" class="btn btn-outline-secondary">Nuevo alquiler</a>
            </div>
        </div>
    </div>
</div>